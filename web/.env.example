# .env.local (committed dev default) and .env.prod (gitignored) hold per-env
# config. APP_ENV picks which one loads (local by default). DB_PATH selects the
# database; give each environment its own file under data/<env>/.
DB_PATH=data/local/db.sqlite3
JWT_SECRET=

# --- Licensing / billing ---------------------------------------------------
# The Ed25519 private key that signs license keys, as base64 PKCS8. Generate a
# pair with `bun run scripts/gen-license-keypair.ts` (it writes the matching
# public key to ../scripts/license-pubkey.bin). KEEP THIS SECRET in prod — do
# NOT commit a production key.
LICENSE_PRIVKEY_B64=

# Stripe. Use test-mode keys (sk_test_…) while developing.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...          # a one-time $25 price on your termset product
STRIPE_WEBHOOK_SECRET=whsec_...    # from the webhook endpoint (or `stripe listen`)

# Public origin the site is served from (used for Checkout success/cancel URLs).
PUBLIC_BASE_URL=http://localhost:3001
