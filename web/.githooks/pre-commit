#!/bin/sh
# Finalize the app DB before committing: fold the WAL into db.sqlite3 so
# the commit contains a single self-contained database file.
set -e
cd "$(git rev-parse --show-toplevel)"

DB=web/data/local/db.sqlite3

# Never commit WAL/shm sidecars.
if git diff --cached --name-only --diff-filter=d | grep -qE '^web/data/[^/]+/db\.sqlite3-(wal|shm)$'; then
  echo "pre-commit: data/db.sqlite3-wal/-shm must not be committed (unstage them)" >&2
  exit 1
fi

if [ -s "$DB-wal" ]; then
  result=$(sqlite3 "$DB" "PRAGMA wal_checkpoint(TRUNCATE);") || {
    echo "pre-commit: wal_checkpoint failed on $DB" >&2
    exit 1
  }
  busy=${result%%|*}
  if [ "$busy" != "0" ] || [ -s "$DB-wal" ]; then
    echo "pre-commit: could not fully checkpoint $DB-wal (a connection is blocking it — stop the app server and retry)" >&2
    exit 1
  fi
  # If the db is part of this commit, restage the finalized file.
  if git diff --cached --name-only | grep -qx "$DB"; then
    git add "$DB"
  fi
fi

# Regenerate the project layout snapshot if `tree` is installed.
if command -v tree >/dev/null 2>&1; then
  LAYOUT=web/PROJECT_LAYOUT.md
  {
    echo '# Project layout'
    echo
    echo 'Generated by the pre-commit hook (`tree`). Do not edit by hand.'
    echo
    echo '```'
    tree -a -I '.git|node_modules|dist|build|data|.githooks' web
    echo '```'
  } > "$LAYOUT"
  git add "$LAYOUT"
fi
